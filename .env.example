# ---------------------------------------------------------------------------
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local. NEVER reuse secrets from another project.
# ---------------------------------------------------------------------------

# --- Core ---
NODE_ENV=development
APP_URL=http://localhost:3000

# --- Database ---
# Use a DEDICATED database name for this project (not a shared/production one).
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
MONGODB_DB=textile_marketplace

# --- Auth ---
# Generate fresh values, do not copy from any other project:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
BCRYPT_COST=12

# --- AI: primary (Hugging Face — preferred by the brief) ---
HF_TOKEN=
HF_CHAT_MODEL=meta-llama/Llama-3.1-8B-Instruct
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
HF_EMBEDDING_DIM=384

# --- AI: fallback (used only when Hugging Face is cold/rate-limited) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Voice (optional, better Indian-accent/Hinglish support than Web Speech) ---
SARVAM_API_KEY=
SARVAM_STT_MODEL=saarika:v2
SARVAM_TTS_MODEL=bulbul:v2

# --- Image uploads ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=textile-marketplace

# --- Cache / rate limiting (optional) ---
REDIS_URL=
REDIS_KEY_PREFIX=mkt:
