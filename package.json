{
  "name": "marketplace",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "seed": "node --env-file=.env --import tsx scripts/seed.ts",
    "seed:verify": "node --env-file=.env --import tsx scripts/verify-seed.ts",
    "smoke:auth": "node scripts/smoke-auth.cjs",
    "smoke:products": "node scripts/smoke-products.cjs",
    "smoke:commerce": "node scripts/smoke-commerce.cjs",
    "smoke": "npm run smoke:auth && npm run smoke:products && npm run smoke:commerce"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.10.0",
    "clsx": "^2.1.1",
    "jose": "^6.2.7",
    "lucide-react": "^1.28.0",
    "mongoose": "^9.9.1",
    "next": "16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5"
  }
